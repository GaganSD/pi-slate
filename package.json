{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Quiet Pi TUI: header, footer, sidebar, and a muted dark theme.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "terminal-ui"
  ],
  "repository": "github:GaganSD/pi-extensions",
  "bugs": "https://github.com/GaganSD/pi-extensions/issues",
  "homepage": "https://github.com/GaganSD/pi-extensions#readme",
  "files": [
    "extensions",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-minimal-ui/index.ts"
    ],
    "themes": [
      "./themes/pi-minimal.json"
    ]
  }
}
